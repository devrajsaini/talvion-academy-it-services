elementorFrontend.elementsHandler.attachHandler("jws_events_advanced",jws_events_advanced);class jws_podcast_episodes extends elementorModules.frontend.handlers.Base{onInit(...e){super.onInit(...e),this.handleDestroy(),this.jws_init()}
getDefaultSettings(){return{selectors:{container:".jws-player-audio",}}}
getDefaultElements(){const e=this.getSettings("selectors"),t={$swiperContainer:this.$element.find(e.slider)};return t.$slides=t.$swiperContainer.find(e.slide),t}
onDestroy(){this.handleDestroy(),super.onDestroy()}
