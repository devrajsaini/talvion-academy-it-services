url=url.replace(/%2C/g,',');window.history.pushState(null,"",url);$(window).bind("popstate",function(){window.location=location.href});clearInterval(intervalID);$.get(url,function(res){$content_page.replaceWith($(res).find('.instructors-advanced-content'));$('.jws-pagination-number').html($(res).find('.jws-pagination-number').html());var iter=0;intervalID=setInterval(function(){$(wap).find('.jws-post-item').eq(iter).addClass('jws-animated');iter++},100);jwsThemeModule.select2_global()},'html')})}
