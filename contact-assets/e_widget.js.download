(function($){"use strict";$(window).on('elementor/frontend/init',function(){class Course_Advanced extends elementorModules.frontend.handlers.SwiperBase{onInit(...e){super.onInit(...e),this.handleDestroy(),this.jws_init()}
getDefaultSettings(){return{selectors:{slider:".courses-advanced-content",slide:".swiper-slide",}}}
getDefaultElements(){const e=this.getSettings("selectors"),t={$swiperContainer:this.$element.find(e.slider)};return t.$slides=t.$swiperContainer.find(e.slide),t}
onDestroy(){this.handleDestroy(),super.onDestroy()}
handleDestroy(){}
jws_init(){const element_setting=this.getElementSettings();this.initSlider();this.tooltipster();this.tabs()}
tooltipster(){}
tabs(){var $this=this.$element;var wrap=$this.find('.courses-advanced-content');$this.find(".courses-nav a").on("click",function(e){e.preventDefault();var intervalID;wrap.addClass('loading');$this.addClass('jws-animated-post');clearInterval(intervalID);var data=$(this).parents('.courses-nav').data('args');if($(this).data('value')!="undefined"){data.custom_cat=$(this).data('value')}
data.action='jws_ajax_courses_filter';$this.find(".courses-nav a").removeClass('active');$(this).addClass('active');if(!wrap.find('.loader').length){wrap.append('<div class="loader"><svg class="circular" viewBox="25 25 50 50"><circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10"/></svg></div>')}
$.ajax({url:jws_script.ajax_url,data:data,type:'POST',dataType:'json',}).success(function(response){wrap.removeClass('loading');let content=response.data.content;if(wrap.hasClass('slider')){wrap.html(content);if(wrap.hasClass('owl-loaded')){wrap.trigger('destroy.owl.carousel')}
jwsThemeModule.owl_caousel_init(wrap)}else{wrap.html(content)}
var iter=0;intervalID=setInterval(function(){wrap.find('.jws-post-item').eq(iter).addClass('jws-animated');iter++},100);jwsThemeModule.js_tooltipster()}).complete(function(){}).error(function(ex){console.log(ex)})})}
