jws_init(){const element_setting=this.getElementSettings();this.player_init();this.chage_episodes()}
player_init(){var $this=this.$element;var players=$this.find('.episodes-audio-player');if(players.length){players.mediaelementplayer({iconSprite:'/images/mejs-controls.svg',features:['playpause','current','progress','duration','volume','tracks','quality','fullscreen'],audioVolume:'vertical',success:function(mediaElement,originalNode,instance){var controls=instance.controls;$(controls).append('<div class="jws-control"><span class="prev"><i class="jws-icon-step-backward"></i></span><span class="next"><i class="jws-icon-step-forward"></i></span></div>')}})}}
chage_episodes(){var self=this;const $this=this.$element;const $players=$this.find('.jws-player-audio');const $player_inner=$this.find('.jws-player-inner');const $next=$this.find('.next');const $prev=$this.find('.prev');const $postContainer=$this.find('[data-playlist]');var playlist=JSON.stringify($postContainer.data('playlist'));var playlist=JSON.parse(playlist);var currentIndex=playlist.indexOf(parseInt($postContainer.data('current')));function loadPost(id){var settings=$players.data('options'),data={};$players.addClass('loading');jwsThemeModule.jws_loader($players);data.id=id;data.action='jws_ajax_podcast_episodes';data.settings=settings;$.ajax({url:jws_script.ajax_url,data:data,type:'POST',dataType:'json',success:function(response){if(response.success&&response.data.result){$player_inner.html(response.data.result);self.player_init()}},error:function(){console.log('error')},complete:function(){$players.removeClass('loading')},})}
$player_inner.on('click','.next',function(){currentIndex++;if(currentIndex>=playlist.length){currentIndex=0}
var nextId=playlist[currentIndex];$postContainer.data('current',nextId);loadPost(nextId)});$player_inner.on('click','.prev',function(){currentIndex--;if(currentIndex<0){currentIndex=playlist.length-1}
var prevId=playlist[currentIndex];$postContainer.data('current',prevId);loadPost(prevId)})}}
