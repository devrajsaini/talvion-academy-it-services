(function($){'use strict';$(document).ready(function(){$('.jws_learndash_woocommerce_payment').each(function(index){$(this).on('submit',function(e){e.preventDefault();var form=$(this);var formData=new FormData(this);$.ajax({url:jws_script.ajax_url,data:formData,method:'POST',contentType:!1,processData:!1,success:function(response){console.log(response);if(response.success){jwsThemeModule.show_notification(response.data.message,'success');window.location.href=jws_script.checkout_url}else{jwsThemeModule.show_notification(response.data[0].message,'error')}},error:function(){console.log('error')},complete:function(){},})})});$(document).on('click','.course-wishlist',function(e){e.preventDefault();var button=$(this),id=button.data('id'),nonce=jws_script.nonce,data={};button.addClass('loading');data.action='jws_course_wishlist'
data.id=id;data.nonce=nonce;jwsThemeModule.jws_loader(button);$.ajax({url:jws_script.ajax_url,data:data,type:'POST',dataType:'json',success:function(response){if(response.success){jwsThemeModule.show_notification(response.data.message,'success');if(!button.hasClass('added')){button.addClass('added')}else{button.removeClass('added');if(button.parents('.ld-dashborad-add-edit-course').length){button.parents('.jws-post-item').remove()}}}else{jwsThemeModule.show_notification(response.data[0].message,'error')}},error:function(){console.log('error')},complete:function(){button.removeClass('loading')},})});$(document).on('click','.courses-report',function(e){if($('body').hasClass('user-not-logged-in')){if($(this).data('login')=='reload'&&!$('.jws-form-login-popup form').find('[name="reload"]').length){$('.jws-form-login-popup form').append('<input type="hidden" name="reload" value="true">')}
$(this).removeAttr('data-modal-jws');$('.jws-form-login-popup').addClass('open');return!1}});$(document).on('submit','.reportForm',function(e){e.preventDefault();var form=$(this);var formData=$(this).serialize();form.addClass('loading');if(!form.find('.loader').length){form.append('<div class="loader"><svg class="circular" viewBox="25 25 50 50"><circle class="path" cx="50" cy="50" r="20" fill="none" stroke-width="2" stroke-miterlimit="10"/></svg></div>')}
$.ajax({url:jws_script.ajax_url,data:formData,method:'POST',success:function(response){if(response.success){$.magnificPopup.close();jwsThemeModule.show_notification(response.data.message,'success')}else{jwsThemeModule.show_notification(response.data[0].message,'error')}},error:function(){jwsThemeModule.show_notification(jws_script.error_notification,'error')},complete:function(){form.removeClass('loading')},})})})})(jQuery)